# SMTP_PASSWORD=abcdabcdabcdabcd
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# Keep SMTP_PASSWORD private. Restart the backend after editing backend/.env.
# Gmail API OAuth is also supported using backend/google_oauth_client.json and setup_gmail_oauth.py.
